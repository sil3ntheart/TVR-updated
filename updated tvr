local PLANT_CONFIG = {
	["Healing Herb"] = { Color = Color3.fromRGB(0, 255, 120),   Label = "Healing Herb", Enabled = false },
	["Vervain"]      = { Color = Color3.fromRGB(255, 80, 200),  Label = "Vervain",      Enabled = false },
	["Wolfsbane"]    = { Color = Color3.fromRGB(180, 120, 255), Label = "Wolfsbane",    Enabled = false },
}

local PlantDrawings = {}
local plantRenderConn = nil
local plantChildConn = nil

local function getPlantConfig(obj)
	if not obj or not obj:IsA("BasePart") then return nil end
	return PLANT_CONFIG[obj.Name]
end

local function createPlantDrawing(obj, cfg)
	if PlantDrawings[obj] then return end
	local label = Drawing.new("Text")
	label.Size = 16
	label.Center = true
	label.Outline = true
	label.Color = cfg.Color
	label.Visible = false
	PlantDrawings[obj] = { label = label }
end

local function destroyPlantDrawing(obj)
	local d = PlantDrawings[obj]
	if not d then return end
	for _, drawing in pairs(d) do pcall(function() drawing:Remove() end) end
	PlantDrawings[obj] = nil
end

local function destroyAllPlantDrawings()
	for obj in pairs(PlantDrawings) do destroyPlantDrawing(obj) end
end

local function refreshPlantSet()
	local map = workspace:FindFirstChild("Map")
	local plants = map and map:FindFirstChild("Plants")
	if not plants then return end
	for _, obj in ipairs(plants:GetChildren()) do
		local cfg = getPlantConfig(obj)
		if cfg and cfg.Enabled then createPlantDrawing(obj, cfg) else destroyPlantDrawing(obj) end
	end
end

local function startPlantRenderer()
	if plantRenderConn then return end
	plantRenderConn = RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then return end
		for obj, drawings in pairs(PlantDrawings) do
			local cfg = getPlantConfig(obj)
			if not cfg or not cfg.Enabled or not obj.Parent then
				destroyPlantDrawing(obj)
				continue
			end
			local pos, onScreen = camera:WorldToViewportPoint(obj.Position)
			if not onScreen then drawings.label.Visible = false; continue end
			local distance = (camera.CFrame.Position - obj.Position).Magnitude
			drawings.label.Text = string.format("%s (%d away)", cfg.Label, math.floor(distance + 0.5))
			drawings.label.Position = Vector2.new(pos.X, pos.Y)
			drawings.label.Visible = true
		end
	end)
end

local function stopPlantRenderer()
	if plantRenderConn then plantRenderConn:Disconnect(); plantRenderConn = nil end
	if plantChildConn then plantChildConn:Disconnect(); plantChildConn = nil end
end

task.spawn(function()
	local map = workspace:WaitForChild("Map", 15)
	local plants = map and map:WaitForChild("Plants", 15)
	if not plants then return end
	startPlantRenderer()
	refreshPlantSet()
	plantChildConn = plants.ChildAdded:Connect(function(obj)
		task.wait(0.1)
		local cfg = getPlantConfig(obj)
		if cfg and cfg.Enabled then createPlantDrawing(obj, cfg) end
	end)
end)

