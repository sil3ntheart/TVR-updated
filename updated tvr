end

local function refreshPlantSet()
	local map = workspace:FindFirstChild("Map")
	local plants = map and map:FindFirstChild("Plants")
	if not plants then return end
	for _, obj in ipairs(plants:GetChildren()) do
		local cfg = getPlantConfig(obj)
		if cfg and cfg.Enabled then createPlantDrawing(obj, cfg) else destroyPlantDrawing(obj) end
	end
end

local function startPlantRenderer()
	if plantRenderConn then return end
	if cleanedUp then return end
	plantRenderConn = RunService.RenderStepped:Connect(function()
		if cleanedUp then return end
		local camera = workspace.CurrentCamera
		if not camera then return end
		for obj, drawings in pairs(PlantDrawings) do
			local cfg = getPlantConfig(obj)
			if not cfg or not cfg.Enabled or not obj.Parent then
				destroyPlantDrawing(obj)
				continue
			end
			local pos, onScreen = camera:WorldToViewportPoint(obj.Position)
			if not onScreen then drawings.label.Visible = false; continue end
