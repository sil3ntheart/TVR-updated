local SPECIES_COLORS = {
	Witch     = Color3.fromRGB(180,  80, 255),
	Vampire   = Color3.fromRGB(255,  60,  60),
	Werewolf  = Color3.fromRGB(255, 150,  40),
	Siphoner  = Color3.fromRGB( 60, 180, 255),
	Human     = Color3.fromRGB( 80, 255, 120),
	Original  = Color3.fromRGB(255,  60,  60),
	Hybrid    = Color3.fromRGB(255,   0, 200),
	Heretic   = Color3.fromRGB(255, 105, 180),
	Unknown   = Color3.fromRGB(200, 200, 200),
}

local POWER_SLOTS = {
	"PowernameG","PowernameT","PowernameY","PowernameF","PowernameC",
	"PowernameB","PowernameV","PowernameX","PowernameE","PowernameR",
}

local function checkHereticPowers(player)
	local pd = player:FindFirstChild("PowerData")
	if not pd then return false end
	for _, slot in ipairs(POWER_SLOTS) do
		local v = pd:FindFirstChild(slot)
		if v and string.lower(tostring(v.Value)):find("heretic", 1, true) then
			return true
		end
	end
	return false
end

local function getSpecies(player)
	local ds = player:FindFirstChild("DataSaves")
	if not ds then return "Unknown" end
	local function read(n)
		local v = ds:FindFirstChild(n)
		return v and tostring(v.Value) or ""
	end
	if checkHereticPowers(player) then
		return "Heretic"
	end
	local tLower = string.lower(read("Trait"))
	if tLower:find("original", 1, true) then return "Original" end
	if tLower:find("hybrid", 1, true) then return "Hybrid" end
	local species = read("Species")
	if species == "" then return "Unknown" end
	local sLower = string.lower(species)
	if sLower:find("witch", 1, true)    then return "Witch"    end
	if sLower:find("siphon", 1, true)   then return "Siphoner" end
	if sLower:find("vampire", 1, true)  then return "Vampire"  end
	if sLower:find("werewolf", 1, true) then return "Werewolf" end
	if sLower:find("human", 1, true)    then return "Human"    end
	return "Unknown"
end

local SpeciesDrawings = {}
local speciesRenderConn = nil
local speciesMasterOn = false

local function createSpeciesText(player)
	if SpeciesDrawings[player] then return SpeciesDrawings[player] end
	local nameLabel = Drawing.new("Text")
	nameLabel.Size = 16
	nameLabel.Center = true
	nameLabel.Outline = true
	nameLabel.Visible = false
	local infoLabel = Drawing.new("Text")
	infoLabel.Size = 12
	infoLabel.Center = true
	infoLabel.Outline = true
	infoLabel.Color = Color3.fromRGB(255, 255, 255)
	infoLabel.Visible = false
	local d = { name = nameLabel, info = infoLabel }
	SpeciesDrawings[player] = d
	return d
end

local function destroySpeciesText(player)
	local d = SpeciesDrawings[player]
	if not d then return end
	for _, dr in pairs(d) do pcall(function() dr:Remove() end) end
	SpeciesDrawings[player] = nil
end

local function clearAllSpeciesText()
	for p in pairs(SpeciesDrawings) do destroySpeciesText(p) end
end

local function startSpeciesRender()
	if speciesRenderConn then return end
	speciesRenderConn = RunService.RenderStepped:Connect(function()
		local camera = workspace.CurrentCamera
		if not camera then return end
		for p in pairs(SpeciesDrawings) do
			local valid = p.Parent
				and p ~= LocalPlayer
				and speciesMasterOn
				and p.Character
				and p.Character:FindFirstChild("Head")
				and p.Character:FindFirstChildOfClass("Humanoid")
				and p.Character:FindFirstChildOfClass("Humanoid").Health > 0
			if not valid then
				destroySpeciesText(p)
			end
		end
		if not speciesMasterOn then return end
		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local head = player.Character:FindFirstChild("Head")
				local hum  = player.Character:FindFirstChildOfClass("Humanoid")
				if head and hum and hum.Health > 0 then
					local d = createSpeciesText(player)
					local species = getSpecies(player)
					local color = SPECIES_COLORS[species] or SPECIES_COLORS.Unknown
					local headPos, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
					local dist = math.floor((camera.CFrame.Position - head.Position).Magnitude + 0.5)
					if onScreen then
						d.name.Text = player.Name
						d.name.Color = color
						d.name.Position = Vector2.new(headPos.X, headPos.Y)
						d.name.Visible = true
						d.info.Text = string.format("%s - %dhp - %d stud", species, math.floor(hum.Health), dist)
						d.info.Color = Color3.fromRGB(255, 255, 255)
						d.info.Position = Vector2.new(headPos.X, headPos.Y + 16)
						d.info.Visible = true
					else
						d.name.Visible = false
						d.info.Visible = false
					end
				end
			end
		end
	end)
end

local function stopSpeciesRender()
	if speciesRenderConn then speciesRenderConn:Disconnect(); speciesRenderConn = nil end
	clearAllSpeciesText()
	speciesMasterOn = false
end

Players.PlayerAdded:Connect(function(p)
	p.CharacterRemoving:Connect(function()
