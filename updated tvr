end

local function createPlantDrawing(obj, cfg)
	if PlantDrawings[obj] then return end
	local label = Drawing.new("Text")
	label.Size = 16
	label.Center = true
	label.Outline = true
	label.Color = cfg.Color
	label.Visible = false
	PlantDrawings[obj] = { label = label }
end

local function destroyPlantDrawing(obj)
	local d = PlantDrawings[obj]
	if not d then return end
	for _, drawing in pairs(d) do pcall(function() drawing:Remove() end) end
	PlantDrawings[obj] = nil
end

local function destroyAllPlantDrawings()
