local sfxState = { muted = false, savedVolumes = {} }
local shakeState = { disabled = false, originals = nil, camShaker = nil }
local sfxConn = nil

local function disableGameSFX()
	if sfxState.muted then return true, "already muted" end
	sfxState.muted = true
	sfxState.savedVolumes = {}

	local function muteSound(s)
		if not s:IsA("Sound") then return end
		sfxState.savedVolumes[s] = s.Volume
		pcall(function() s.Volume = 0 end)
	end

	for _, s in ipairs(SoundService:GetDescendants()) do muteSound(s) end
	local rsEffects = ReplicatedStorage:FindFirstChild("Effects")
	local rsAudios = rsEffects and rsEffects:FindFirstChild("Audios")
	if rsAudios then
		for _, s in ipairs(rsAudios:GetDescendants()) do muteSound(s) end
	end
	for _, s in ipairs(workspace:GetDescendants()) do
		if s:IsA("Sound") then muteSound(s) end
	end

	sfxConn = SoundService.DescendantAdded:Connect(function(s)
		if s:IsA("Sound") and sfxState.muted then
			task.wait(0)
			sfxState.savedVolumes[s] = s.Volume
			pcall(function() s.Volume = 0 end)
		end
	end)
	return true, "muted"
end

local function restoreGameSFX()
	if not sfxState.muted then return end
	sfxState.muted = false
	if sfxConn then sfxConn:Disconnect(); sfxConn = nil end
	for s, v in pairs(sfxState.savedVolumes) do
		if s and s.Parent then
			pcall(function() s.Volume = v end)
		end
	end
	sfxState.savedVolumes = {}
end

local function disableShakes()
	if shakeState.disabled then return true, "already disabled" end
	local modules = ReplicatedStorage:FindFirstChild("Modules")
	local camShakerModule = modules and modules:FindFirstChild("CameraShaker")
	if not camShakerModule then
		return false, "CameraShaker module not found"
	end

	local ok, camShaker = pcall(require, camShakerModule)
	if not ok or type(camShaker) ~= "table" then
		return false, "CameraShaker module could not be required"
	end

	shakeState.disabled = true
	shakeState.camShaker = camShaker

	shakeState.originals = {
		Shake = camShaker.Shake,
		StartShake = camShaker.StartShake,
	}

	pcall(function()
		if type(camShaker.Shake) == "function" then camShaker.Shake = function() end end
		if type(camShaker.StartShake) == "function" then camShaker.StartShake = function() end end
		if type(camShaker.SetEnabled) == "function" then camShaker:SetEnabled(false) end
		if camShaker.Enabled ~= nil then camShaker.Enabled = false end
	end)
	return true, "disabled"
end

local function restoreShakes()
	if not shakeState.disabled then return end
	shakeState.disabled = false
	local camShaker = shakeState.camShaker
	local originals = shakeState.originals
	if camShaker and originals then
		pcall(function()
			if originals.Shake ~= nil then camShaker.Shake = originals.Shake end
			if originals.StartShake ~= nil then camShaker.StartShake = originals.StartShake end
			if type(camShaker.SetEnabled) == "function" then camShaker:SetEnabled(true) end
			if camShaker.Enabled ~= nil then camShaker.Enabled = true end
		end)
	end
	shakeState.camShaker = nil
	shakeState.originals = nil
end

