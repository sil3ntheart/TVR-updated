		WorldTab._teleportTarget = value
	end,
})

WorldTab:Button({
	Text = "Teleport to Player",
	Description = "Moves you to the selected player's location.",
	Icon = "map-pin",
	Callback = function()
		local targetName = WorldTab._teleportTarget
		if not targetName then
			Menu:Notify({ Title = "Teleport", Content = "No player selected.", Type = "Warning" })
			return
		end

		local targetPlayer = Players:FindFirstChild(targetName)
		if not targetPlayer then
			Menu:Notify({ Title = "Teleport", Content = "Player not found.", Type = "Error" })
			return
		end

		local targetChar = targetPlayer.Character
		if not targetChar then
			Menu:Notify({ Title = "Teleport", Content = "Target has no character.", Type = "Error" })
			return
		end

		local targetRoot = targetChar:FindFirstChild("HumanoidRootPart")
		if not targetRoot then
			Menu:Notify({ Title = "Teleport", Content = "Target root not found.", Type = "Error" })
			return
		end

		local myChar = LocalPlayer.Character
		if not myChar then
			Menu:Notify({ Title = "Teleport", Content = "You have no character.", Type = "Error" })
			return
		end

		local myRoot = myChar:FindFirstChild("HumanoidRootPart")
		if not myRoot then
			Menu:Notify({ Title = "Teleport", Content = "Your root not found.", Type = "Error" })
			return
		end

		myRoot.CFrame = targetRoot.CFrame
		Menu:Notify({ Title = "Teleport", Content = "Teleported to " .. targetName, Type = "Success" })
	end,
})

