WorldTab:BoldLabel({ Text = "Noclip" })

local noclipEnabled = false
local noclipConnection = nil
local noclipModified = {}

local function clearNoclipTracking()
	for part in pairs(noclipModified) do
		if part and part.Parent then
			pcall(function() part.CanCollide = true end)
		end
	end
	noclipModified = {}
end

WorldTab:Toggle({
	Text = "Enable Noclip",
	Description = "Walk through walls and objects.",
	Default = false,
	Callback = function(value)
		noclipEnabled = value
		if value then
			noclipConnection = RunService.Stepped:Connect(function()
				if not noclipEnabled then return end
				local char = LocalPlayer.Character
				if not char then return end
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						noclipModified[part] = true
						part.CanCollide = false
					end
				end
			end)
			Menu:Notify({ Title = "Noclip", Content = "Enabled.", Type = "Success" })
		else
			if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
			clearNoclipTracking()
			Menu:Notify({ Title = "Noclip", Content = "Disabled.", Type = "Info" })
		end
	end,
})

LocalPlayer.CharacterAdded:Connect(function()
	clearNoclipTracking()
	if noclipEnabled then
		task.wait(0.5)
		local char = LocalPlayer.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					noclipModified[part] = true
					part.CanCollide = false
				end
			end
		end
	end
end)

