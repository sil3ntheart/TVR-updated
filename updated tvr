local SPECIES_COLORS = {
	Witch     = Color3.fromRGB(180,  80, 255),
	Vampire   = Color3.fromRGB(255,  60,  60),
	Werewolf  = Color3.fromRGB(255, 150,  40),
	Siphoner  = Color3.fromRGB( 60, 180, 255),
	Human     = Color3.fromRGB( 80, 255, 120),
	Original  = Color3.fromRGB(255,  60,  60),
	Hybrid    = Color3.fromRGB(255,   0, 200),
	Heretic   = Color3.fromRGB(255, 105, 180),
	Unknown   = Color3.fromRGB(200, 200, 200),
}

local function checkHereticPowers(player)
	local pd = player:FindFirstChild("PowerData")
	if not pd then return false end
	for _, v in ipairs(pd:GetChildren()) do
		if v:IsA("ValueBase") and string.lower(tostring(v.Value)):find("heretic", 1, true) then
			return true
		end
	end
	return false
end

local function getSpecies(player)
	local ds = player:FindFirstChild("DataSaves")
	if not ds then return "Unknown" end
	local function read(n)
		local v = ds:FindFirstChild(n)
		return v and tostring(v.Value) or ""
	end
	if checkHereticPowers(player) then
		return "Heretic"
	end
	local tLower = string.lower(read("Trait"))
	if tLower:find("original", 1, true) then return "Original" end
	if tLower:find("hybrid", 1, true) then return "Hybrid" end
	local species = read("Species")
	if species == "" then return "Unknown" end
	local sLower = string.lower(species)
	if sLower:find("witch", 1, true)    then return "Witch"    end
	if sLower:find("siphon", 1, true)   then return "Siphoner" end
	if sLower:find("vampire", 1, true)  then return "Vampire"  end
	if sLower:find("werewolf", 1, true) then return "Werewolf" end
	if sLower:find("human", 1, true)    then return "Human"    end
	return "Unknown"
end

local SpeciesDrawings = {}
local speciesRenderConn = nil
local speciesMasterOn = false

local speciesCache = {}
local SPECIES_CACHE_INTERVAL = 0.5
local speciesCacheTimer = 0

local boundPlayers = {}
local playerAddedConn = nil
local playerRemovingConn = nil
local characterRemovingConns = {}
local playerBindings = {}

local function createSpeciesText(player)
	if SpeciesDrawings[player] then return SpeciesDrawings[player] end
	local nameLabel = Drawing.new("Text")
	nameLabel.Size = 16
	nameLabel.Center = true
	nameLabel.Outline = true
	nameLabel.Visible = false
	local infoLabel = Drawing.new("Text")
	infoLabel.Size = 12
	infoLabel.Center = true
	infoLabel.Outline = true
	infoLabel.Color = Color3.fromRGB(255, 255, 255)
	infoLabel.Visible = false
	local d = { name = nameLabel, info = infoLabel }
	SpeciesDrawings[player] = d
	return d
end

local function destroySpeciesText(player)
	local d = SpeciesDrawings[player]
	if not d then return end
	for _, dr in pairs(d) do pcall(function() dr:Remove() end) end
	SpeciesDrawings[player] = nil
	local c = speciesCache[player]
	if c and c.dsConn then
		pcall(function() c.dsConn:Disconnect() end)
	end
	if c and c.pdConn then
		pcall(function() c.pdConn:Disconnect() end)
	end
	speciesCache[player] = nil
end

local function clearAllSpeciesText()
	local players = {}
	for p in pairs(SpeciesDrawings) do table.insert(players, p) end
	for _, p in ipairs(players) do destroySpeciesText(p) end
end

local function disconnectPlayerBindings(player)
	local binds = playerBindings[player]
	if not binds then return end
	for _, c in ipairs(binds) do
		pcall(function() c:Disconnect() end)
	end
	playerBindings[player] = nil
end

local function refreshSpeciesCache(player, force)
	local cached = speciesCache[player]
	if cached and not force then return cached.species end

	local species = getSpecies(player)
	local entry = cached or {}

	local ds = player:FindFirstChild("DataSaves")
	if entry.ds ~= ds then
		if entry.dsConn then pcall(function() entry.dsConn:Disconnect() end) end
		entry.ds = ds
		entry.dsConn = nil
		if ds then
			entry.dsConn = ds.DescendantAdded:Connect(function()
				if speciesCache[player] then refreshSpeciesCache(player, true) end
			end)
		end
	end

	local pd = player:FindFirstChild("PowerData")
	if entry.pd ~= pd then
		if entry.pdConn then pcall(function() entry.pdConn:Disconnect() end) end
		entry.pd = pd
		entry.pdConn = nil
		if pd then
			entry.pdConn = pd.DescendantAdded:Connect(function()
				if speciesCache[player] then refreshSpeciesCache(player, true) end
			end)
		end
	end

	entry.species = species
	entry.t = os.clock()
	speciesCache[player] = entry
	return species
end

local function addPlayerBinding(player, conn)
	local binds = playerBindings[player]
	if not binds then
		binds = {}
		playerBindings[player] = binds
	end
	table.insert(binds, conn)
	return conn
end

local function bindDataSavesValues(player)
	local ds = player:FindFirstChild("DataSaves")
	if not ds then
		local conn
		conn = player.ChildAdded:Connect(function(c)
			if c.Name == "DataSaves" then
				conn:Disconnect()
				if boundPlayers[player] then
					bindDataSavesValues(player)
				end
			end
		end)
		addPlayerBinding(player, conn)
		return
	end
	for _, name in ipairs({ "Species", "Trait" }) do
		local v = ds:FindFirstChild(name)
		if v and v:IsA("ValueBase") then
			local conn = v.Changed:Connect(function()
				if speciesMasterOn and speciesCache[player] then
					refreshSpeciesCache(player, true)
				end
			end)
			addPlayerBinding(player, conn)
		end
	end
end

local function bindPlayerForESP(player)
	if player == LocalPlayer then return end
	if not speciesMasterOn then return end
	if boundPlayers[player] then
		refreshSpeciesCache(player, true)
		return
	end
	boundPlayers[player] = true

	refreshSpeciesCache(player, true)
	bindDataSavesValues(player)

	local function onCharacter(char)
		local conn = char.ChildAdded:Connect(function(child)
			if child.Name == "Humanoid" and speciesMasterOn then
				refreshSpeciesCache(player, true)
			end
		end)
		addPlayerBinding(player, conn)
	end

	if player.Character then onCharacter(player.Character) end
	local charAddedConn = player.CharacterAdded:Connect(onCharacter)
	addPlayerBinding(player, charAddedConn)

	if not characterRemovingConns[player] then
		characterRemovingConns[player] = player.CharacterRemoving:Connect(function()
			destroySpeciesText(player)
		end)
	end
end

local function startSpeciesRender()
	if speciesRenderConn then return end
	if cleanedUp then return end

	for _, p in ipairs(Players:GetPlayers()) do
		bindPlayerForESP(p)
	end

	speciesRenderConn = RunService.RenderStepped:Connect(function()
		if cleanedUp then return end
		local camera = workspace.CurrentCamera
		if not camera then return end

		local toRemove = {}
		for p in pairs(SpeciesDrawings) do
			local valid = p.Parent
				and p ~= LocalPlayer
				and speciesMasterOn
				and p.Character
				and p.Character:FindFirstChild("Head")
				and p.Character:FindFirstChildOfClass("Humanoid")
				and p.Character:FindFirstChildOfClass("Humanoid").Health > 0
			if not valid then
				table.insert(toRemove, p)
			end
		end
		for _, p in ipairs(toRemove) do
			destroySpeciesText(p)
		end

		if not speciesMasterOn then return end

		local now = os.clock()
		local periodicRefresh = (now - speciesCacheTimer) >= SPECIES_CACHE_INTERVAL
		if periodicRefresh then
			speciesCacheTimer = now
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and speciesCache[player] then
					refreshSpeciesCache(player, true)
				end
			end
		end

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer and player.Character then
				local head = player.Character:FindFirstChild("Head")
				local hum  = player.Character:FindFirstChildOfClass("Humanoid")
				if head and hum and hum.Health > 0 then
					local d = createSpeciesText(player)

					local species = refreshSpeciesCache(player, not speciesCache[player])

					local color = SPECIES_COLORS[species] or SPECIES_COLORS.Unknown
					local headPos, onScreen = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
					local dist = math.floor((camera.CFrame.Position - head.Position).Magnitude + 0.5)

					if onScreen then
						d.name.Text = player.Name
						d.name.Color = color
						d.name.Position = Vector2.new(headPos.X, headPos.Y)
						d.name.Visible = true

						d.info.Text = string.format("%s - %dhp - %d stud", species, math.floor(hum.Health), dist)
						d.info.Position = Vector2.new(headPos.X, headPos.Y + 16)
						d.info.Visible = true
					else
						d.name.Visible = false
						d.info.Visible = false
					end
				end
			end
		end
	end)
end

local function stopSpeciesRender()
	if speciesRenderConn then speciesRenderConn:Disconnect(); speciesRenderConn = nil end
	clearAllSpeciesText()

	for p in pairs(playerBindings) do
		disconnectPlayerBindings(p)
	end
	playerBindings = {}

	for _, c in pairs(speciesCache) do
		if c.dsConn then pcall(function() c.dsConn:Disconnect() end) end
		if c.pdConn then pcall(function() c.pdConn:Disconnect() end) end
	end
	speciesCache = {}
	boundPlayers = {}
	speciesMasterOn = false
end

local function destroyAllESPBindings()
	if playerAddedConn then playerAddedConn:Disconnect(); playerAddedConn = nil end
	if playerRemovingConn then playerRemovingConn:Disconnect(); playerRemovingConn = nil end
	for p, conn in pairs(characterRemovingConns) do
		pcall(function() conn:Disconnect() end)
		characterRemovingConns[p] = nil
	end
	for p in pairs(playerBindings) do
		disconnectPlayerBindings(p)
	end
	playerBindings = {}
	boundPlayers = {}
end

playerAddedConn = Players.PlayerAdded:Connect(function(p)
	if cleanedUp then return end
	if speciesMasterOn then
		bindPlayerForESP(p)
	else
		if not characterRemovingConns[p] then
			characterRemovingConns[p] = p.CharacterRemoving:Connect(function()
				destroySpeciesText(p)
			end)
		end
	end
end)

for _, p in ipairs(Players:GetPlayers()) do
	if not characterRemovingConns[p] then
		characterRemovingConns[p] = p.CharacterRemoving:Connect(function()
			destroySpeciesText(p)
		end)
	end
end

playerRemovingConn = Players.PlayerRemoving:Connect(function(p)
	destroySpeciesText(p)
	if characterRemovingConns[p] then
		pcall(function() characterRemovingConns[p]:Disconnect() end)
		characterRemovingConns[p] = nil
	end
	disconnectPlayerBindings(p)
	boundPlayers[p] = nil
end)

