WorldTab:BoldLabel({ Text = "Speed" })

local speedEnabled = false
local speedValue = 16
local speedConnection = nil

local function applySpeed()
	local char = LocalPlayer.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = speedValue
	end
end

WorldTab:Toggle({
	Text = "Enable Speed",
	Description = "Move faster than the default walkspeed.",
	Default = false,
	Callback = function(value)
		speedEnabled = value

		if value then
			speedConnection = RunService.Heartbeat:Connect(function()
				if not speedEnabled then return end
				applySpeed()
			end)
			applySpeed()
			Menu:Notify({ Title = "Speed", Content = "Enabled.", Type = "Success" })
		else
			if speedConnection then
				speedConnection:Disconnect()
				speedConnection = nil
			end
			local char = LocalPlayer.Character
			local humanoid = char and char:FindFirstChildOfClass("Humanoid")
			if humanoid then
				humanoid.WalkSpeed = 16
			end
			Menu:Notify({ Title = "Speed", Content = "Disabled.", Type = "Info" })
		end
	end,
})

WorldTab:Slider({
	Text = "Speed Value",
	Description = "Your character's walk speed.",
	Min = 16,
	Max = 500,
	Step = 1,
	Default = 16,
	Suffix = " studs/s",
	Callback = function(value)
		speedValue = value
		if speedEnabled then
			applySpeed()
		end
	end,
})

WorldTab:Divider()

WorldTab:BoldLabel({ Text = "Noclip" })

local noclipEnabled = false
local noclipConnection = nil

WorldTab:Toggle({
	Text = "Enable Noclip",
	Description = "Walk through walls and objects.",
	Default = false,
	Callback = function(value)
		noclipEnabled = value

		if value then
			noclipConnection = RunService.Stepped:Connect(function()
				if not noclipEnabled then return end
				local char = LocalPlayer.Character
				if not char then return end
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						part.CanCollide = false
					end
				end
			end)
			Menu:Notify({ Title = "Noclip", Content = "Enabled.", Type = "Success" })
		else
			if noclipConnection then
				noclipConnection:Disconnect()
				noclipConnection = nil
			end
			local char = LocalPlayer.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
					end
				end
			end
			Menu:Notify({ Title = "Noclip", Content = "Disabled.", Type = "Info" })
		end
	end,
})

