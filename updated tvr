		end
		local closest, closestDist = nil, math.huge
		for _, obj in ipairs(plants:GetChildren()) do
			if obj.Name == plantName and obj:IsA("BasePart") then
				local dist = (obj.Position - myRoot.Position).Magnitude
				if dist < closestDist then
					closestDist = dist
					closest = obj
				end
			end
		end
		if not closest then
			Menu:Notify({ Title = "Plant TP", Content = "No " .. plantName .. " found.", Type = "Warning" })
			return
		end
		myRoot.CFrame = CFrame.new(closest.Position + Vector3.new(0, 3, 0))
		Menu:Notify({ Title = "Plant TP", Content = "Teleported to " .. plantName .. " (" .. math.floor(closestDist) .. " studs).", Type = "Success" })
	end,
})

