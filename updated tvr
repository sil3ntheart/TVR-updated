local function getHouseSign(house)
	if not house then return nil end
	local sign = house:FindFirstChild("Sign")
	if sign then
		local inner = sign:FindFirstChild("Sign")
		if inner and inner:IsA("BasePart") then return inner end
		if sign:IsA("BasePart") then return sign end
	end
	for _, d in ipairs(house:GetDescendants()) do
		if d:IsA("BasePart") then return d end
	end
	return nil
end

