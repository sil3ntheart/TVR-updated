local function listHouseNames()
	local names = {}
	local root = getBuyableRoot()
	if not root then return names end
	for _, h in ipairs(root:GetChildren()) do
		if h:IsA("Folder") and h.Name:match("^House%d+$") then
			table.insert(names, h.Name)
		end
	end
	table.sort(names, function(a, b)
		return (tonumber(a:match("%d+")) or 0) < (tonumber(b:match("%d+")) or 0)
	end)
	return names
end

local function getHouseDisplayNames()
	local display = {}
	for _, realName in ipairs(listHouseNames()) do
		table.insert(display, getHouseLabel(realName))
	end
	return display
end

local function displayToRealName(display)
	if not display then return nil end
	for realName, label in pairs(HOUSE_LABELS) do
		if label == display then
			return realName
		end
	end
	if display:match("^House%d+$") then return display end
	return nil
end

